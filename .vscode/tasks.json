{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cargo Build",
            "command": "cargo",
            "type": "shell",
            "args": [
                "build"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cargo Run (info)",
            "command": "cargo",
            "type": "shell",
            "args": [
                "run"
            ],
            "options": {
                "env": {
                    "RUST_LOG": "info"
                }
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
        },
        {
            "label": "Cargo Run (debug)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run"
            ],
            "options": {
                "env": {
                    "RUST_LOG": "debug"
                }
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Cargo Run (release)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--release"
            ],
            "options": {
                "env": {
                    "RUST_LOG": "info"
                }
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
            },
        }
    ]
}